# ---------- Database (Neon) ----------
# Pooled connection (host contains -pooler) for the app
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/mcstore?sslmode=require"
# Direct connection for migrations
DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/mcstore?sslmode=require"

# ---------- Domains ----------
ROOT_DOMAIN="business.com"          # use "localhost:3000" locally
WEB_PROTOCOL="https"                # "http" locally
API_URL="http://localhost:4000"             # used server-side by the web app (internal URL is fine)
PUBLIC_API_URL="https://api.business.com"   # browser-facing API URL (Discord redirects)

# ---------- API ----------
PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
SUPERADMIN_EMAIL="owner@business.com"
SUPERADMIN_PASSWORD="change-me"

# Discord OAuth (player SSO). Redirect URI to register in Discord:
#   ${API_URL}/v1/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Object storage (Cloudflare R2 / any S3) for logos, QR codes, package images
S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="mcstore"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL="https://cdn.business.com"

# Hours after which an order with no payment reference is auto-cancelled
PENDING_ORDER_TTL_HOURS=24
