{
  "name": "mc-store-cms",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @mcstore/db generate",
    "db:migrate": "pnpm --filter @mcstore/db migrate",
    "db:deploy": "pnpm --filter @mcstore/db deploy",
    "db:seed": "pnpm --filter @mcstore/db seed",
    "db:studio": "pnpm --filter @mcstore/db studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
